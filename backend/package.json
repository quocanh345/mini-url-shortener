{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server.ts",
    "start": "node --env-file-if-exists=.env server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
